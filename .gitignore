# Dependencies
node_modules/

# The dashboard-upload bundle, made by `npm run zip` from dist/
tarsia-web-dist.zip

# Build output — regenerated by `npm run build`, and it is BASE_PATH-specific
# (a root build and a /tarsia/ build differ), so committing it would just
# invite deploying the wrong one.
dist/

# Local Claude Code settings (launch.json IS tracked — the dev/preview server
# config is worth sharing; only the per-machine settings are not)
.claude/settings.local.json

# macOS
.DS_Store

# Logs / debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pairs-table-preview.pdf
